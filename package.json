{
  "name": "pi-wechat-assistant",
  "version": "0.6.4",
  "type": "module",
  "description": "在微信里继续 pi 对话：双向同步、图片与文件、会话交接。 Continue pi conversations from WeChat.",
  "main": "index.ts",
  "license": "MIT",
  "author": "sj",
  "homepage": "https://github.com/shenjiecode/pi-wechat-assistant#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shenjiecode/pi-wechat-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/shenjiecode/pi-wechat-assistant/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "wechat",
    "微信",
    "ilink",
    "bot",
    "assistant",
    "agent"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run check:architecture && npm test && npm run check:docs && npm run check:package",
    "check:docs": "node scripts/check-docs.mjs",
    "check:package": "node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:pi": "node scripts/check-pi-compat.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preversion": "npm run check && npm run typecheck:pi",
    "prepack": "npm run typecheck",
    "check:architecture": "node scripts/check-architecture.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "files": [
    "index.ts",
    "src",
    "prompts",
    "docs",
    "assets",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "image": "https://raw.githubusercontent.com/shenjiecode/pi-wechat-assistant/main/assets/cover.png",
    "extensions": [
      "./index.ts"
    ],
    "prompts": []
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^22.10.5",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.3"
    }
  }
}
